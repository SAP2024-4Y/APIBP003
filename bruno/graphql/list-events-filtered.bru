meta {
  name: GraphQL - List Events with Filters
  type: http
  seq: 2
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  query {
    events(category: "MUSIC", min_price: 100, max_price: 500, sort: "base_price", order: "asc", limit: 10) {
      edges {
        cursor
        node {
          id
          title
          category
          base_price
          venue {
            name
          }
        }
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
}
