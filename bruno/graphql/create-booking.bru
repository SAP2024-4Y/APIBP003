meta {
  name: GraphQL - Create Booking
  type: http
  seq: 6
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:graphql {
  mutation {
    createBooking(input: { slotId: "1", quantity: 2 }) {
      id
      quantity
      createdAt
      slot {
        id
        starts_at
        ends_at
        available
        event {
          title
        }
      }
    }
  }
}
