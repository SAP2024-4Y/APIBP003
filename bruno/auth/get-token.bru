meta {
  name: Get Token
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/token
  body: json
  auth: none
}

body:json {
  {
    "username": "demo",
    "password": "demo-password"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.token);
  }
}
